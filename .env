# =============================================================================
# MCP SERVER CONFIGURATION
# (Choose ONE of these by commenting/uncommenting)
# =============================================================================

# --- Profile A: Windows MCP + MSSQL (VPN / prod) ---
# MCP_SERVER_URL=http://192.168.1.35:8000
# MCP_API_KEY=supersecretapikey

# --- Profile B: Local MCP + local Postgres (Northwind) ---
MCP_SERVER_URL=http://localhost:8000
MCP_API_KEY=supersecretapikey

# =============================================================================
# LANGGRAPH SERVICE CONFIGURATION (Runs on Mac)
# =============================================================================
LANGGRAPH_URL=http://localhost:5001
LANGGRAPH_API_KEY=supersecretapikey
API_KEY=supersecretapikey

# =============================================================================
# LOCAL POSTGRES CONFIG (used ONLY if MCP runs locally on Mac)
# =============================================================================
# These are read by the MCP server process, not by the Mac startup script itself.
# If MCP is on Windows, you set equivalent vars on the Windows side instead.

# For LOCAL MCP + Northwind:
DB_DIALECT=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=55432
POSTGRES_DATABASE=northwind
POSTGRES_DB=northwind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SCHEMA=public

DB_HOST=localhost
DB_PORT=55432
DB_NAME=northwind
DB_USER=postgres
DB_PASSWORD=postgres
DB_SCHEMA=public

# =============================================================================
# WEB UI CONFIGURATION (Runs on Mac)
# =============================================================================
WEB_UI_HOST=localhost
WEB_UI_PORT=3000

# =============================================================================
# QUERY SAFETY & PERFORMANCE
# =============================================================================
MAX_QUERY_RESULTS=1000
QUERY_TIMEOUT=30
MIN_POOL_SIZE=1
MAX_POOL_SIZE=10

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/application.log

# =============================================================================
# EVALUATION & BENCHMARK CONFIGURATION
# =============================================================================
# Enable evaluation tracking (1 = enabled, 0 = disabled)
EVAL_ENABLED=1
# Evaluation service URL (optional, e.g., http://localhost:7001)
# Leave empty or comment out to disable evaluation service integration
EVAL_TRACKING_URL=http://localhost:7001