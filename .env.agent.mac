# Agent Environment Configuration (Mac)
# Prompt 6: Declarative config; no secrets in the agent

# Database Client Mode Configuration
DB_MODE=proxy

# Proxy Connection Settings
PROXY_BASE_URL=https://10.255.152.48:5000
PROXY_API_KEY=your_secure_api_key_here

# TLS/SSL Configuration
PROXY_TLS_VERIFY=true

# Optional: Custom CA Bundle for self-signed certificates
# Uncomment and set path if using self-signed certificates
# PROXY_CA_BUNDLE=/path/to/proxy.crt

# Optional: Default connection name for queries
# Uncomment and set if you want a default connection
# PROXY_DEFAULT_CONN=corp_sql_erp

# Request Configuration
PROXY_TIMEOUT=30
PROXY_MAX_RETRIES=3

# Development Mode Override
# Uncomment to use direct database connection for local development
# DB_MODE=direct

# Note: Agent never needs database credentials when using proxy mode
# All database access is routed through the secure proxy server