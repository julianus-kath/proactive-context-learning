# =============================================================================
# SIMPLE SQL AGENT CONFIGURATION
# =============================================================================
# Copy this file to .env and fill in your actual values

# MCP Server URL (Windows for MSSQL, or localhost for Postgres)
MCP_SERVER_URL=http://YOUR_MCP_SERVER_IP:8000
MCP_API_KEY=your-mcp-api-key

# OpenAI API Key (required for GPT-4o)
OPENAI_API_KEY=sk-your-openai-api-key

# Service Authentication
API_KEY=your-api-key

# =============================================================================
# WEB UI
# =============================================================================
WEB_UI_HOST=localhost
WEB_UI_PORT=3000

# =============================================================================
# DATABASE CONFIGURATION (for MCP Server)
# =============================================================================

# Choose dialect: "postgres" or "mssql"
DB_DIALECT=mssql

# --- MSSQL (Production) ---
MSSQL_SERVER=your-mssql-server-ip
MSSQL_PORT=1433
MSSQL_DATABASE=YourDatabase
MSSQL_USER=your-username
MSSQL_PASSWORD=your-password
MSSQL_DRIVER="ODBC Driver 17 for SQL Server"

# --- PostgreSQL (Local for testing) ---
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=northwind
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_SCHEMA=public

# =============================================================================
# QUERY SAFETY
# =============================================================================
MAX_QUERY_RESULTS=1000
QUERY_TIMEOUT=30

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO
