# ============================================================================
# Thesis Demo — Local Configuration
# ============================================================================
# Only OPENAI_API_KEY is required. All other values have sensible defaults
# that work out of the box with the bundled Postgres + Northwind demo.
#
# Quick start:
#   cp .env.example .env
#   $EDITOR .env         # add your OPENAI_API_KEY
#   ./run.sh
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional: override the default LLM (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# --- OPTIONAL: Port overrides (change if defaults conflict on your machine) -
# WEB_UI_PORT=3000
# SQL_AGENT_PORT=5001
# MCP_PORT=8000
# POSTGRES_PORT=55432

# --- OPTIONAL: Internal shared secrets --------------------------------------
# Used between the local services. Defaults are fine for a localhost-only
# demo; randomize if you expose any service publicly.
# MCP_API_KEY=local-dev-mcp-key
# API_KEY=local-dev-api-key

# --- OPTIONAL: Scout Mode configuration -------------------------------------
# Set to "true" to enable SDG (semantic description generation) at catalog
# build time. This costs ~$0.05 in OpenAI calls on Northwind's 14 tables.
# The default (false) runs the structural Scout catalog only.
# SCOUT_DESCRIPTIONS_ENABLED=false

# ============================================================================
# Connecting to a different database (advanced)
# ============================================================================
# By default the stack runs a bundled Postgres container seeded with
# Northwind. To connect to an external database instead, override the
# mcp_server service env in a docker-compose.override.yml file.
#
# Postgres example (override):
#   services:
#     mcp_server:
#       environment:
#         POSTGRES_HOST: your-host
#         POSTGRES_PORT: "5432"
#         POSTGRES_DATABASE: your_db
#         POSTGRES_USER: your_user
#         POSTGRES_PASSWORD: your_password
#
# MSSQL (production path, e.g. Sage/ERP integration):
#   Requires ODBC Driver 17 on the host AND a working VPN/network route to
#   the server. The bundled Railway image already includes the ODBC driver.
#   For a local Mac/Linux setup, see docs/MSSQL_SETUP.md (if present) or
#   follow Microsoft's ODBC install instructions.
#
#   services:
#     mcp_server:
#       environment:
#         DB_DIALECT: mssql
#         MSSQL_SERVER: your-sql-host
#         MSSQL_PORT: "1433"
#         MSSQL_DATABASE: YourDatabase
#         MSSQL_USER: your_user
#         MSSQL_PASSWORD: your_password
