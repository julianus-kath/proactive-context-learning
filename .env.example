# ============================================================================
# Thesis Demo — Local Configuration
# ============================================================================
# Only OPENAI_API_KEY is required. All other values have sensible defaults
# that work out of the box with the bundled Postgres + Northwind demo.
#
# Quick start:
#   cp .env.example .env
#   $EDITOR .env         # add your OPENAI_API_KEY
#   ./run.sh
# ============================================================================

# --- REQUIRED ---------------------------------------------------------------
OPENAI_API_KEY=sk-...
# Optional: override the default LLM (default: gpt-4o)
# OPENAI_MODEL=gpt-4o

# --- OPTIONAL: Port overrides (change if defaults conflict on your machine) -
# WEB_UI_PORT=3000
# SQL_AGENT_PORT=5001
# MCP_PORT=8000
# POSTGRES_PORT=55432

# --- OPTIONAL: Internal shared secrets --------------------------------------
# Used between the local services. Defaults are fine for a localhost-only
# demo; randomize if you expose any service publicly.
# MCP_API_KEY=local-dev-mcp-key
# API_KEY=local-dev-api-key

# --- OPTIONAL: Semantic Description Generator (SDG) -------------------------
# SDG is the primary H2a ablation axis (see ADR-0035 and ADR-0036). The three
# thesis-defined conditions map to two toggles:
#
#   sdg_off       — ENABLED=false                          (structural only)
#   sdg_payload   — ENABLED=true,  RANKING=false           (descriptions in payload)
#   sdg_ranker    — ENABLED=true,  RANKING=true            (descriptions in ranker)
#
# When ENABLED=true, the catalog build calls an LLM once per table. Cost on
# Northwind (14 tables) is ~$0.05; cost on Sage (~943 tables) is ~$3 on first
# build, then cached on disk.

# Toggle 1: generate descriptions at catalog build time
# SCOUT_DESCRIPTIONS_ENABLED=false

# Toggle 2: feed descriptions into the table-ranker scoring (only relevant
# when ENABLED=true)
# SCOUT_DESCRIPTIONS_RANKING=false

# Provider for description generation. Default: anthropic.
# Both providers require their respective API key to be set below.
# SCOUT_DESCRIPTIONS_PROVIDER=anthropic        # anthropic | openai
# SCOUT_DESCRIPTIONS_MODEL=claude-sonnet-4-20250514

# Prompt variant. Use "northwind" for the controlled benchmark and "sage"
# for the production case study; the prompts differ in domain framing.
# SCOUT_DESCRIPTIONS_DATABASE_TYPE=northwind   # northwind | sage

# Disk cache for generated descriptions. Survives container rebuilds when
# the path is on a mounted volume.
# SCOUT_DESCRIPTIONS_CACHE_PATH=data/catalog/sdg_cache.json

# --- API key for the SDG provider -------------------------------------------
# Required when SCOUT_DESCRIPTIONS_ENABLED=true AND the provider needs it.
# - PROVIDER=anthropic → ANTHROPIC_API_KEY must be set
# - PROVIDER=openai    → OPENAI_API_KEY (already set above) is reused
# Without the key, generation silently falls back to empty descriptions.
# ANTHROPIC_API_KEY=sk-ant-...

# ============================================================================
# Connecting to a different database (advanced)
# ============================================================================
# By default the stack runs a bundled Postgres container seeded with
# Northwind. To connect to an external database instead, override the
# mcp_server service env in a docker-compose.override.yml file.
#
# Postgres example (override):
#   services:
#     mcp_server:
#       environment:
#         POSTGRES_HOST: your-host
#         POSTGRES_PORT: "5432"
#         POSTGRES_DATABASE: your_db
#         POSTGRES_USER: your_user
#         POSTGRES_PASSWORD: your_password
#
# MSSQL (production path, e.g. Sage/ERP integration):
#   Requires ODBC Driver 17 on the host AND a working VPN/network route to
#   the server. The bundled Railway image already includes the ODBC driver.
#   For a local Mac/Linux setup, see docs/MSSQL_SETUP.md (if present) or
#   follow Microsoft's ODBC install instructions.
#
#   services:
#     mcp_server:
#       environment:
#         DB_DIALECT: mssql
#         MSSQL_SERVER: your-sql-host
#         MSSQL_PORT: "1433"
#         MSSQL_DATABASE: YourDatabase
#         MSSQL_USER: your_user
#         MSSQL_PASSWORD: your_password
