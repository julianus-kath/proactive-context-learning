# PostgreSQL Database Configuration - mywebshop
DB_TYPE=postgresql
DB_HOST=localhost
DB_PORT=5432
DB_NAME=mywebshop
DB_SCHEMA=webshop
DB_USER=postgres
DB_PASSWORD=

