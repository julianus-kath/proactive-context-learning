# Proxy Environment Configuration Template (Windows)
# Copy this to .env.proxy.windows and customize with your values

# Proxy Server Binding Configuration
PROXY_BIND_HOST=0.0.0.0
PROXY_PORT=5000

# API Authentication
PROXY_API_KEY=your_secure_api_key_here

# TLS/SSL Certificate Configuration
PROXY_TLS_CERT_FILE=C:\temp\sqlproxy\proxy.crt
PROXY_TLS_KEY_FILE=C:\temp\sqlproxy\proxy.key

# Database Connection Secrets (consumed by YAML expansion)
SQLSERVER_PASSWORD=your_sqlserver_password_here
PG_PASSWORD=your_postgresql_password_here

# Optional: Additional database passwords
# MYSQL_PASSWORD=your_mysql_password_here
# ORACLE_PASSWORD=your_oracle_password_here

# Proxy Operational Settings
PROXY_MAX_CONNECTIONS=100
PROXY_QUERY_TIMEOUT=30
PROXY_MAX_QUERY_SIZE=1048576

# Logging Configuration
PROXY_LOG_LEVEL=INFO
PROXY_LOG_FILE=C:\temp\sqlproxy\proxy.log

# Security Settings
PROXY_RATE_LIMIT_PER_MINUTE=60
PROXY_MAX_REQUEST_SIZE=262144

# Connection Pool Settings
PROXY_POOL_SIZE=10
PROXY_POOL_TIMEOUT=30