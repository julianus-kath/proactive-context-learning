# =============================================================================
# PROXY CONFIGURATION FOR YOUR WINDOWS LAPTOP
# =============================================================================
# Copy this content to your .env file to connect the agent to your proxy

# Database mode: use proxy (your Windows laptop)
DB_MODE=proxy

# Proxy connection settings - REPLACE [YOUR_WINDOWS_IP] with actual IP
PROXY_BASE_URL=http://[YOUR_WINDOWS_IP]:5000
PROXY_API_KEY=not_required_in_simple_mode
PROXY_DEFAULT_CONN=corp_sql_erp
PROXY_TLS_VERIFY=false
PROXY_TIMEOUT=30

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO