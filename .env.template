# =============================================================================
# MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and configure for your environment
# Different components use different subsets of these variables

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Local SQLite (for development)
SQL_DB_PATH=/app/synthetic_data.db

# PostgreSQL (primary database)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=mywebshop
POSTGRES_USER=your_username
POSTGRES_PASSWORD=your_password

# MongoDB (document store)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=document_store

# Neo4j (knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# =============================================================================
# PROXY CONFIGURATION (VPN/Windows Server)
# =============================================================================
# Proxy server settings (for Windows server)
PROXY_HOST=0.0.0.0
PROXY_PORT=5000
PROXY_API_KEY=your_secure_api_key_here
PROXY_TLS_CERT_PATH=./certs/proxy.crt
PROXY_TLS_KEY_PATH=./certs/proxy.key
PROXY_CONNECTIONS_CONFIG=./connections.yaml
PROXY_RATE_LIMIT_PER_MINUTE=30
PROXY_MAX_REQUEST_SIZE=262144

# Proxy client settings (for Mac agent)
PROXY_BASE_URL=https://10.255.152.48:5000
PROXY_DEFAULT_CONN=corp_sql_erp
PROXY_CA_CERT_PATH=./certs/proxy.crt

# Database mode: proxy (default) or direct (fallback)
DB_MODE=proxy

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================
MCP_SERVER_HOST=localhost
MCP_SERVER_PORT=8000

# =============================================================================
# WEB UI CONFIGURATION
# =============================================================================
FLASK_ENV=development
FLASK_DEBUG=true
WEB_UI_HOST=localhost
WEB_UI_PORT=5001

# =============================================================================
# LANGGRAPH INTEGRATION
# =============================================================================
LANGGRAPH_API_KEY=your_langgraph_api_key_here

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECRET_KEY=your_secret_key_for_sessions
JWT_SECRET=your_jwt_secret_here

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/application.log