# =============================================================================
# MASTER ENVIRONMENT CONFIGURATION TEMPLATE
# =============================================================================
# Copy this file to .env and configure for your environment
# Different components use different subsets of these variables

# =============================================================================
# LLM PROVIDER CONFIGURATION
# =============================================================================
LLM_PROVIDER=openai
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================
# Local SQLite (for development)
SQL_DB_PATH=/app/synthetic_data.db

# PostgreSQL (for local development on Mac)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=synthetic_erp_data
POSTGRES_USER=juli
POSTGRES_PASSWORD=

# MongoDB (document store)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB=document_store

# Neo4j (knowledge graph)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your_password

# =============================================================================
# DEPLOYMENT ARCHITECTURE CONFIGURATION
# =============================================================================
# Choose your deployment mode:
# - "windows" = Windows machine running MCP server with VPN access to SQL Server
# - "mac" = Mac machine running Web UI + LangGraph (connects to Windows MCP server)
# - "local" = Local development mode (all services on one machine with PostgreSQL)

DEPLOYMENT_MODE=local  # Change to "windows" or "mac" based on your machine

# =============================================================================
# MCP SERVER CONFIGURATION (Windows Machine)
# =============================================================================
# Use these settings on Windows machine that has VPN access to SQL Server
# The MCP server provides database access to Mac machine over the network

# MCP Server Settings (Windows)
MCP_SERVER_HOST=0.0.0.0  # Listen on all interfaces (allows Mac to connect)
MCP_SERVER_PORT=8000
MCP_API_KEY=supersecretapikey  # Must match on both Mac and Windows

# SQL Server Configuration (Windows only - requires VPN)
DB_DIALECT=mssql  # Use "mssql" on Windows, "postgres" for local dev
MSSQL_SERVER=192.168.200.16
MSSQL_PORT=1433
MSSQL_DATABASE=master
MSSQL_USER=SimonM
MSSQL_PASSWORD=your_password_here
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# =============================================================================
# MCP CLIENT CONFIGURATION (Mac Machine)
# =============================================================================
# Use these settings on Mac machine running Web UI + LangGraph
# Points to the Windows MCP server

MCP_SERVER_URL=http://10.255.152.48:8000  # Replace with your Windows IP
# MCP_API_KEY is defined above - must match Windows

# =============================================================================
# DEPRECATED: OLD PROXY CONFIGURATION
# =============================================================================
# The proxy.py has been replaced by the MCP server
# These settings are kept for backward compatibility but are no longer used
# PROXY_HOST=0.0.0.0
# PROXY_PORT=5000
# PROXY_API_KEY=your_secure_api_key_here
# PROXY_BASE_URL=https://10.255.152.48:5000
# DB_MODE=proxy  # No longer supported - use DB_DIALECT instead

# =============================================================================
# QUERY SAFETY & PERFORMANCE
# =============================================================================
MAX_QUERY_RESULTS=1000
QUERY_TIMEOUT=30
MIN_POOL_SIZE=1
MAX_POOL_SIZE=10

# =============================================================================
# WEB UI CONFIGURATION (Mac Machine)
# =============================================================================
WEB_UI_HOST=localhost
WEB_UI_PORT=3000

# =============================================================================
# LANGGRAPH SERVICE CONFIGURATION (Mac Machine)
# =============================================================================
LANGGRAPH_URL=http://localhost:5001
LANGGRAPH_API_KEY=supersecretapikey

# =============================================================================
# SECURITY SETTINGS
# =============================================================================
SECRET_KEY=your_secret_key_for_sessions
JWT_SECRET=your_jwt_secret_here

# =============================================================================
# LOGGING CONFIGURATION
# =============================================================================
LOG_LEVEL=INFO
LOG_FILE=./logs/application.log