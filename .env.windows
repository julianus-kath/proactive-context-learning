# =============================================================================
# WINDOWS MACHINE CONFIGURATION - MCP Server Only
# =============================================================================
# This file is for the Windows machine that has VPN access to SQL Server.
# Copy this to .env on your Windows machine.
#
# The Windows machine runs ONLY the MCP server, which provides database access
# to the Mac machine over the network.
# =============================================================================

# =============================================================================
# MCP SERVER CONFIGURATION
# =============================================================================
MCP_SERVER_HOST=0.0.0.0  # Listen on all interfaces (allows Mac to connect)
MCP_SERVER_PORT=8000
MCP_API_KEY=supersecretapikey  # Must match Mac's MCP_API_KEY

# =============================================================================
# DATABASE CONFIGURATION - SQL Server (Production)
# =============================================================================
# The MCP server on Windows connects directly to SQL Server via VPN
DB_DIALECT=mssql

# SQL Server Configuration
MSSQL_SERVER=192.168.200.16
MSSQL_PORT=1433
MSSQL_DATABASE=master
MSSQL_USER=SimonM
MSSQL_PASSWORD=your_password_here
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# =============================================================================
# QUERY SAFETY & PERFORMANCE
# =============================================================================
MAX_QUERY_RESULTS=1000
QUERY_TIMEOUT=30
MIN_POOL_SIZE=1
MAX_POOL_SIZE=10

# =============================================================================
# LOGGING
# =============================================================================
LOG_LEVEL=INFO