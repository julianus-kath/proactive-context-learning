FROM python:3.9-slim

WORKDIR /app

# Install system dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    && rm -rf /var/lib/apt/lists/*

# Install MongoDB dependencies explicitly
RUN pip install --no-cache-dir motor pymongo fastapi uvicorn

# Copy the entire project
COPY . .

# Make sure the package is installed in development mode
RUN pip install -e .

# Default command
CMD ["python", "-m", "crawling_agent.api.doc_api", "--host", "0.0.0.0", "--port", "8002"]