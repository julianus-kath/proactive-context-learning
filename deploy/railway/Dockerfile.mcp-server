FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        curl \
        gcc \
        g++ \
        unixodbc \
        unixodbc-dev \
    && rm -rf /var/lib/apt/lists/*

COPY mcp_server/requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt

COPY mcp_server /app/mcp_server
COPY data /app/data

RUN mkdir -p /app/data/catalog

EXPOSE 8080

CMD ["sh", "-c", "uvicorn mcp_server.server.app:app --host 0.0.0.0 --port ${PORT:-8080}"]
