FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY simple_sql_agent/requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt

COPY simple_sql_agent /app/simple_sql_agent

RUN mkdir -p /app/logs/conversations /app/data

EXPOSE 8080

CMD ["python", "-m", "simple_sql_agent.service"]
