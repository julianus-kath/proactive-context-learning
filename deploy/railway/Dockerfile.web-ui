FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

COPY chatbot_ui/requirements.txt /app/requirements.txt
RUN pip install -r /app/requirements.txt

COPY chatbot_ui /app/chatbot_ui

EXPOSE 8080

CMD ["sh", "-c", "uvicorn chatbot_ui.web_app:app --host 0.0.0.0 --port ${PORT:-8080}"]
