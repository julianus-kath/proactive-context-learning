    {
      "query_id": "NW7",
      "question": "Which suppliers provide products that are frequently ordered together in the same order?",
      "status": "success",
      "latency_ms": 5675,
      "sql_query": "SELECT s.company_name, COUNT(*) AS frequency\nFROM public.suppliers s\nJOIN public.products p ON s.supplier_id = p.supplier_id\nJOIN public.order_details od1 ON p.product_id = od1.product_id\nJOIN public.order_details od2 ON od1.order_id = od2.order_id AND od1.product_id <> od2.product_id\nGROUP BY s.company_name\nORDER BY frequency DESC\nLIMIT 5;",
      "tables_used": [
        "public.suppliers",
        "public.products",
        "public.order_details"
      ],
