    {
      "query_id": "NW3",
      "question": "Which customers have placed more than 10 orders, and what is their total order value?",
      "status": "success",
      "latency_ms": 6252,
      "sql_query": "SELECT c.company_name, COUNT(o.order_id) AS order_count, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_order_value\nFROM public.customers c\nJOIN public.orders o ON c.customer_id = o.customer_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY c.company_name\nHAVING COUNT(o.order_id) > 10",
