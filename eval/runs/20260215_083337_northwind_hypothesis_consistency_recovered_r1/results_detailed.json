    {
      "query_id": "NW7",
      "question": "Which suppliers provide products that are frequently ordered together in the same order?",
      "status": "success",
      "latency_ms": 7514,
      "sql_query": "SELECT s.company_name, COUNT(*) AS frequency\nFROM public.suppliers s\nJOIN public.products p ON s.supplier_id = p.supplier_id\nJOIN public.order_details od1 ON p.product_id = od1.product_id\nJOIN public.order_details od2 ON od1.order_id = od2.order_id AND od1.product_id <> od2.product_id\nJOIN public.products p2 ON od2.product_id = p2.product_id\nJOIN public.suppliers s2 ON p2.supplier_id = s2.supplier_id\nWHERE s.supplier_id <> s2.supplier_id\nGROUP BY s.company_name\nORDER BY frequency DESC\nLIMIT 5;",
      "tables_used": [
        "public.suppliers",
        "public.products",
        "public.order_details"
      ],
      "final_answer": "The suppliers whose products are frequently ordered together in the same order are:\n\n1. **Plutzer Lebensmittelgro\u00dfm\u00e4rkte AG** with 386 occurrences\n2. **Specialty Biscuits, Ltd.** with 341 occurrences\n3. **Pavlova, Ltd.** with 337 occurrences\n4. **Gai p\u00e2turage** with 238 occurrences\n5. **Formaggi Fortini s.r.l.** with 224 occurrences\n\nThese suppliers provide products that are often included in the same customer orders.",
