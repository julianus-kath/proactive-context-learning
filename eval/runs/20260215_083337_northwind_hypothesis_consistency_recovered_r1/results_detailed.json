    {
      "query_id": "NW5",
      "question": "Which employees have generated the most revenue from their orders?",
      "status": "success",
      "latency_ms": 6245,
      "sql_query": "SELECT e.employee_id, e.first_name, e.last_name, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS revenue\nFROM public.employees e\nJOIN public.orders o ON e.employee_id = o.employee_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY e.employee_id, e.first_name, e.last_name\nORDER BY revenue DESC\nLIMIT 5;",
