  "NW3": {
    "query_id": "NW3",
    "question": "Which customers have placed more than 10 orders, and what is their total order value?",
    "status": "success",
    "final_answer_text": "Here are some of the customers who have placed more than 10 orders along with their total order value:\n\n1. **Wilman Kala**: 17 orders, total order value of approximately 3,161.35\n2. **Magazzini Alimentari Riuniti**: 21 orders, total order value of approximately 7,176.21\n3. **Wellington Importadora**: 19 orders, total order value of approximately 6,068.20\n4. **Furia Bacalhau e Frutos do Mar**: 20 orders, total order value of approximately 6,427.42\n5. **Toms Spezialit\u00e4ten**: 14 orders, total order value of approximately 4,778.14\n\nThese are just a few examples; there are more customers with similar order patterns.",
    "sql_generated": [
      "SELECT c.company_name, COUNT(o.order_id) AS order_count, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_order_value\nFROM public.customers c\nJOIN public.orders o ON c.customer_id = o.customer_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY c.company_name\nHAVING COUNT(o.order_id) > 10"
    ],
    "sql_executed": [
      "SELECT c.company_name, COUNT(o.order_id) AS order_count, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_order_value\nFROM public.customers c\nJOIN public.orders o ON c.customer_id = o.customer_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY c.company_name\nHAVING COUNT(o.order_id) > 10"
    ],
    "tables_used": [
      "public.customers",
      "public.orders",
      "public.order_details"
