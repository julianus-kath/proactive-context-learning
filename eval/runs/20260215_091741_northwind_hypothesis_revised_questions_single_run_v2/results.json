  "NW8": {
    "query_id": "NW8",
    "question": "Calculate average order value by customer country, where each order value is summed per order before taking the country average.",
    "status": "success",
    "final_answer_text": "Here is the average order value by customer country, where each order value is summed per order before taking the country average:\n\n1. **Austria**: CHF 3,200.10\n2. **Ireland**: CHF 2,630.52\n3. **USA**: CHF 2,012.99\n4. **Germany**: CHF 1,887.58\n5. **Denmark**: CHF 1,814.50\n6. **Belgium**: CHF 1,780.26\n7. **Switzerland**: CHF 1,760.70\n8. **Canada**: CHF 1,673.21\n9. **Sweden**: CHF 1,472.84\n10. **Brazil**: CHF 1,288.26\n\nThese values represent the average order value for each country, calculated by summing the order values per order and then averaging them by country.",
    "sql_generated": [
      "SELECT c.country, AVG(order_value) AS average_order_value\nFROM (\n    SELECT o.customer_id, o.order_id, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS order_value\n    FROM public.orders o\n    JOIN public.order_details od ON o.order_id = od.order_id\n    GROUP BY o.order_id\n) AS order_totals\nJOIN public.customers c ON order_totals.customer_id = c.customer_id\nGROUP BY c.country\nORDER BY average_order_value DESC;"
    ],
    "sql_executed": [
      "SELECT c.country, AVG(order_value) AS average_order_value\nFROM (\n    SELECT o.customer_id, o.order_id, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS order_value\n    FROM public.orders o\n    JOIN public.order_details od ON o.order_id = od.order_id\n    GROUP BY o.order_id\n) AS order_totals\nJOIN public.customers c ON order_totals.customer_id = c.customer_id\nGROUP BY c.country\nORDER BY average_order_value DESC;"
    ],
    "tables_used": [
      "public.orders",
      "public.order_details",
      "public.customers"
