  "NW3": {
    "query_id": "NW3",
    "question": "Which customers have placed more than 10 distinct orders, and what is their total order value?",
    "status": "success",
    "final_answer_text": "Here are some of the customers who have placed more than 10 distinct orders along with their total order value:\n\n1. **Around the Horn**: 13 orders, total value CHF 13,390.65\n2. **Berglunds snabbk\u00f6p**: 18 orders, total value CHF 24,927.58\n3. **Blondesddsl p\u00e8re et fils**: 11 orders, total value CHF 18,534.08\n4. **Bon app'**: 17 orders, total value CHF 21,963.25\n5. **Bottom-Dollar Markets**: 14 orders, total value CHF 20,801.60\n\nThese are just a few examples from the list. If you need more details, let me know!",
    "sql_generated": [
      "SELECT c.company_name, COUNT(DISTINCT o.order_id) AS order_count, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_order_value\nFROM public.customers c\nJOIN public.orders o ON c.customer_id = o.customer_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY c.company_name\nHAVING COUNT(DISTINCT o.order_id) > 10"
    ],
    "sql_executed": [
      "SELECT c.company_name, COUNT(DISTINCT o.order_id) AS order_count, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_order_value\nFROM public.customers c\nJOIN public.orders o ON c.customer_id = o.customer_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY c.company_name\nHAVING COUNT(DISTINCT o.order_id) > 10"
    ],
    "tables_used": [
      "public.customers",
      "public.orders",
      "public.order_details"
    ],
