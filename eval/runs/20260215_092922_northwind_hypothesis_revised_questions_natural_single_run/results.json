  "NW8": {
    "query_id": "NW8",
    "question": "By customer country, compute the average order value where each order is totaled first and then averaged at the country level.",
    "status": "success",
    "final_answer_text": "Here is the average order value by customer country, where each order is totaled first and then averaged at the country level:\n\n- Spain: 781.88\n- Argentina: 507.44\n- Switzerland: 1760.70\n- Italy: 563.22\n- Venezuela: 1235.01\n- Belgium: 1780.26\n- Norway: 955.86\n- Sweden: 1472.84\n- France: 1056.60\n- USA: 2012.99\n- Mexico: 842.22\n- Brazil: 1288.26\n- Austria: 3200.10\n- Poland: 504.56\n- UK: 1053.06\n- Ireland: 2630.52\n- Germany: 1887.58\n- Denmark: 1814.50\n- Canada: 1673.21\n- Finland: 855.00\n\nThese values represent the average order value for each country.",
    "sql_generated": [
      "SELECT c.country, AVG(order_total) AS average_order_value\nFROM (\n    SELECT o.customer_id, o.order_id, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS order_total\n    FROM public.orders o\n    JOIN public.order_details od ON o.order_id = od.order_id\n    GROUP BY o.order_id\n) AS order_totals\nJOIN public.customers c ON order_totals.customer_id = c.customer_id\nGROUP BY c.country;"
    ],
    "sql_executed": [
      "SELECT c.country, AVG(order_total) AS average_order_value\nFROM (\n    SELECT o.customer_id, o.order_id, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS order_total\n    FROM public.orders o\n    JOIN public.order_details od ON o.order_id = od.order_id\n    GROUP BY o.order_id\n) AS order_totals\nJOIN public.customers c ON order_totals.customer_id = c.customer_id\nGROUP BY c.country;"
    ],
    "tables_used": [
      "public.orders",
      "public.order_details",
