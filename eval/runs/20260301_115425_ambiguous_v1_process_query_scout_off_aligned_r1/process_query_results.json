  "NW8": {
    "query_id": "NW8",
    "question": "How does average order value differ across customer countries?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 5075,
    "error": null,
    "final_response_text": "The average order value varies significantly across customer countries. Here are some highlights:\n\n- **Austria** has the highest average order value at approximately $1,024.\n- **Ireland** follows with an average order value of about $909.\n- **Denmark** and **Germany** have average order values of $710 and $702, respectively.\n- **USA** and **Canada** have average order values around $698 and $669.\n\nThese values indicate differences in purchasing behavior or pricing strategies across countries.",
