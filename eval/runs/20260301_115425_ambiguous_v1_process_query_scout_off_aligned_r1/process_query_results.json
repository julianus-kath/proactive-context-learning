  "NW3": {
    "query_id": "NW3",
    "question": "Which customers order unusually often, and roughly how much business do they represent for us?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 3279,
    "error": null,
    "final_response_text": "The customers who order unusually often and represent significant business for us are:\n\n1. **Save-a-lot Markets**: 116 orders, totaling approximately $104,362.\n2. **Ernst Handel**: 102 orders, totaling approximately $104,875.\n3. **QUICK-Stop**: 86 orders, totaling approximately $110,277.\n4. **Rattlesnake Canyon Grocery**: 71 orders, totaling approximately $51,098.\n5. **Hungry Owl All-Night Grocers**: 55 orders, totaling approximately $49,980.\n\nThese customers have a higher order frequency compared to the average.",
    "sql_query": "SELECT c.company_name, COUNT(o.order_id) AS order_count, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_business\nFROM public.customers c\nJOIN public.orders o ON c.customer_id = o.customer_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY c.company_name\nHAVING COUNT(o.order_id) > (SELECT AVG(order_count) FROM (SELECT COUNT(order_id) AS order_count FROM public.orders GROUP BY customer_id) AS subquery)\nORDER BY order_count DESC, total_business DESC\nLIMIT 5;",
