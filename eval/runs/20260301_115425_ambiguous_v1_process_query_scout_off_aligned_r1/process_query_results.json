  "NW9": {
    "query_id": "NW9",
    "question": "How many orders are still unshipped, and what are they worth after discounts?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 3023,
    "error": null,
    "final_response_text": "There are 73 unshipped orders, with a total value of approximately $25,937.43 after applying discounts.",
    "sql_query": "SELECT COUNT(o.order_id) AS unshipped_orders_count, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_value_after_discounts\nFROM public.orders o\nJOIN public.order_details od ON o.order_id = od.order_id\nWHERE o.shipped_date IS NULL;",
    "exec_result": {
