  "NW3": {
    "query_id": "NW3",
    "question": "Which customers order unusually often, and roughly how much business do they represent for us?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 3062,
    "error": null,
    "final_response_text": "The customers who order unusually often and represent significant business for us are:\n\n1. **Save-a-lot Markets**: 116 orders, approximately $104,362 in business.\n2. **Ernst Handel**: 102 orders, approximately $104,875 in business.\n3. **QUICK-Stop**: 86 orders, approximately $110,277 in business.\n4. **Rattlesnake Canyon Grocery**: 71 orders, approximately $51,098 in business.\n5. **Hungry Owl All-Night Grocers**: 55 orders, approximately $49,980 in business.\n\nThese customers are among the top in terms of order frequency and business value.",
    "sql_query": "SELECT c.company_name, COUNT(o.order_id) AS order_count, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_business\nFROM public.customers c\nJOIN public.orders o ON c.customer_id = o.customer_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY c.company_name\nORDER BY order_count DESC\nLIMIT 5;",
