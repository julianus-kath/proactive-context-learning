  "NW10": {
    "query_id": "NW10",
    "question": "How has revenue trended month by month after discounts?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 3397,
    "error": null,
    "final_response_text": "The revenue after discounts has shown a general upward trend month by month. Here are some key figures:\n\n- July 1996: CHF 27,861.90\n- January 1997: CHF 61,258.07\n- December 1997: CHF 71,398.43\n- January 1998: CHF 94,222.11\n- February 1998: CHF 99,415.29\n\nThis indicates a steady increase in revenue over the observed period.",
    "sql_query": "SELECT TO_CHAR(o.order_date, 'YYYY-MM') AS month, \n       SUM(od.unit_price * od.quantity * (1 - od.discount)) AS revenue_after_discounts\nFROM public.orders o\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY TO_CHAR(o.order_date, 'YYYY-MM')\nORDER BY month;",
