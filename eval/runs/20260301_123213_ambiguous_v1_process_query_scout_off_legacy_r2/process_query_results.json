  "NW2": {
    "query_id": "NW2",
    "question": "Which product categories actually generate the most revenue once discounts are considered?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 3039,
    "error": null,
    "final_response_text": "The top product categories generating the most revenue, considering discounts, are:\n\n1. **Beverages** with a total revenue of approximately $267,868.\n2. **Dairy Products** with a total revenue of approximately $234,507.\n3. **Confections** with a total revenue of approximately $167,357.\n4. **Meat/Poultry** with a total revenue of approximately $163,022.\n5. **Seafood** with a total revenue of approximately $131,262.",
    "sql_query": "SELECT c.category_name, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_revenue\nFROM public.order_details od\nJOIN public.products p ON od.product_id = p.product_id\nJOIN public.categories c ON p.category_id = c.category_id\nGROUP BY c.category_name\nORDER BY total_revenue DESC\nLIMIT 5;",
