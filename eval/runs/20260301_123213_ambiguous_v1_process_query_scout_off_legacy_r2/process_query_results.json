  "NW5": {
    "query_id": "NW5",
    "question": "Which employees drive the most sales revenue after discounts?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 5676,
    "error": null,
    "final_response_text": "The top 5 employees driving the most sales revenue after discounts are:\n\n1. **Margaret Peacock** with a total revenue of approximately $232,891.\n2. **Janet Leverling** with a total revenue of approximately $202,813.\n3. **Nancy Davolio** with a total revenue of approximately $192,108.\n4. **Andrew Fuller** with a total revenue of approximately $166,538.\n5. **Laura Callahan** with a total revenue of approximately $126,862.",
    "sql_query": "SELECT e.employee_id, e.first_name, e.last_name, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_revenue\nFROM public.employees e\nJOIN public.orders o ON e.employee_id = o.employee_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY e.employee_id, e.first_name, e.last_name\nORDER BY total_revenue DESC\nLIMIT 5;",
