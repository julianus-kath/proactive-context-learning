  "NW3": {
    "query_id": "NW3",
    "question": "Which customers order unusually often, and roughly how much business do they represent for us?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 3474,
    "error": null,
    "final_response_text": "The customers who order unusually often and represent significant business for us are:\n\n1. **Save-a-lot Markets**: 31 orders, totaling approximately $6,684 in business.\n2. **Ernst Handel**: 30 orders, totaling approximately $6,205 in business.\n3. **QUICK-Stop**: 28 orders, totaling approximately $5,606 in business.\n4. **Hungry Owl All-Night Grocers**: 19 orders, totaling approximately $2,755 in business.\n5. **Folk och f\u00e4 HB**: 19 orders, totaling approximately $1,678 in business.\n\nThese customers have a higher order frequency compared to the average.",
    "sql_query": "SELECT c.company_name, COUNT(o.order_id) AS order_count, SUM(o.freight) AS total_business\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nGROUP BY c.company_name\nHAVING COUNT(o.order_id) > (SELECT AVG(order_count) FROM (SELECT COUNT(order_id) AS order_count FROM public.orders GROUP BY customer_id) AS subquery)\nORDER BY order_count DESC, total_business DESC\nLIMIT 5;",
