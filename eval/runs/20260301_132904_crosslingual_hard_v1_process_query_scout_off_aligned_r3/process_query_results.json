  "CL2": {
    "query_id": "CL2",
    "question": "Welche Kundenl\u00e4nder bringen den gr\u00f6\u00dften Gesamtumsatz nach Abz\u00fcgen?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 3790,
    "error": null,
    "final_response_text": "Die f\u00fcnf Kundenl\u00e4nder mit dem gr\u00f6\u00dften Gesamtumsatz nach Abz\u00fcgen sind:\n\n1. USA mit einem Umsatz von 245'584.61\n2. Deutschland mit einem Umsatz von 230'284.63\n3. \u00d6sterreich mit einem Umsatz von 128'003.84\n4. Brasilien mit einem Umsatz von 106'925.78\n5. Frankreich mit einem Umsatz von 81'358.32",
    "sql_query": "SELECT c.country, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_revenue\nFROM public.customers c\nJOIN public.orders o ON c.customer_id = o.customer_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY c.country\nORDER BY total_revenue DESC\nLIMIT 5;",
