  "CL2": {
    "query_id": "CL2",
    "question": "Welche Kundenl\u00e4nder bringen den gr\u00f6\u00dften Gesamtumsatz nach Abz\u00fcgen?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 13138,
    "error": null,
    "final_response_text": "Die f\u00fcnf Kundenl\u00e4nder mit dem gr\u00f6\u00dften Gesamtumsatz nach Abz\u00fcgen sind:\n\n1. **USA** mit einem Umsatz von etwa 245'585\n2. **Deutschland** mit einem Umsatz von etwa 230'285\n3. **\u00d6sterreich** mit einem Umsatz von etwa 128'004\n4. **Brasilien** mit einem Umsatz von etwa 106'926\n5. **Frankreich** mit einem Umsatz von etwa 81'358\n\nDiese Werte ber\u00fccksichtigen die Rabatte, die auf die Bestellungen angewendet wurden.",
    "sql_query": "SELECT o.ship_country AS Land, \n       SUM(od.unit_price * od.quantity * (1 - od.discount)) AS Gesamtumsatz_nach_Abz\u00fcgen\nFROM public.orders o\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY o.ship_country\nORDER BY Gesamtumsatz_nach_Abz\u00fcgen DESC\nLIMIT 5;",
