  "CL1": {
    "query_id": "CL1",
    "question": "Welche Lieferanten erzielen den h\u00f6chsten Umsatz nach Rabatten \u00fcber ihre Artikel?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 3472,
    "error": null,
    "final_response_text": "Die Lieferanten mit dem h\u00f6chsten Umsatz nach Rabatten \u00fcber ihre Artikel sind:\n\n1. **Aux joyeux eccl\u00e9siastiques** mit einem Umsatz von CHF 153'691.28\n2. **Plutzer Lebensmittelgro\u00dfm\u00e4rkte AG** mit einem Umsatz von CHF 145'372.40\n3. **Gai p\u00e2turage** mit einem Umsatz von CHF 117'981.18\n4. **Pavlova, Ltd.** mit einem Umsatz von CHF 106'459.78\n5. **G'day, Mate** mit einem Umsatz von CHF 65'626.77",
    "sql_query": "SELECT s.company_name, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_revenue\nFROM public.order_details od\nJOIN public.products p ON od.product_id = p.product_id\nJOIN public.suppliers s ON p.supplier_id = s.supplier_id\nGROUP BY s.company_name\nORDER BY total_revenue DESC\nLIMIT 5;",
