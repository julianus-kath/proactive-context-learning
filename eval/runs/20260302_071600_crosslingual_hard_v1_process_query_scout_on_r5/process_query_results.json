  "CL2": {
    "query_id": "CL2",
    "question": "Welche Kundenl\u00e4nder bringen den gr\u00f6\u00dften Gesamtumsatz nach Abz\u00fcgen?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 7814,
    "error": null,
    "final_response_text": "Die f\u00fcnf Kundenl\u00e4nder mit dem gr\u00f6\u00dften Gesamtumsatz nach Abz\u00fcgen sind:\n\n1. **USA**: CHF 245,585\n2. **Deutschland**: CHF 230,285\n3. **\u00d6sterreich**: CHF 128,004\n4. **Brasilien**: CHF 106,926\n5. **Frankreich**: CHF 81,358\n\nDiese Ums\u00e4tze ber\u00fccksichtigen die Abz\u00fcge durch Rabatte.",
    "sql_query": "SELECT c.country, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_revenue\nFROM public.customers c\nJOIN public.orders o ON c.customer_id = o.customer_id\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY c.country\nORDER BY total_revenue DESC\nLIMIT 5;",
