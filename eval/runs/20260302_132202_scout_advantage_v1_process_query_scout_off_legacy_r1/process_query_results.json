  "SA4": {
    "query_id": "SA4",
    "question": "Wie entwickeln sich monatlich Auftragseingaenge im Vergleich zu stark verspaeteten Zustellungen?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 12015,
    "error": null,
    "final_response_text": "Hier sind die monatlichen Auftragseing\u00e4nge im Vergleich zu stark versp\u00e4teten Zustellungen:\n\n- Im Januar 1997 gab es 33 Auftragseing\u00e4nge und 1 stark versp\u00e4tete Zustellung.\n- Im April 1997 gab es 31 Auftragseing\u00e4nge und 1 stark versp\u00e4tete Zustellung.\n- Im September 1997 gab es 37 Auftragseing\u00e4nge und 2 stark versp\u00e4tete Zustellungen.\n- Im Dezember 1997 gab es 48 Auftragseing\u00e4nge und 1 stark versp\u00e4tete Zustellung.\n- Im Januar 1998 gab es 55 Auftragseing\u00e4nge und 2 stark versp\u00e4tete Zustellungen.\n\nDie meisten Monate hatten keine stark versp\u00e4teten Zustellungen, was auf eine insgesamt gute Liefertreue hinweist.",
    "sql_query": "SELECT \n    DATE_TRUNC('month', order_date) AS monat, \n    COUNT(order_id) AS auftragseingaenge, \n    SUM(CASE WHEN shipped_date > required_date + INTERVAL '7 days' THEN 1 ELSE 0 END) AS stark_verspaetete_zustellungen\nFROM \n    public.orders\nGROUP BY \n    monat\nORDER BY \n    monat;",
