  "SA1": {
    "query_id": "SA1",
    "question": "Welche Absatzmaerkte liefern nach Preisnachlaessen den hoechsten Nettoerloes?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 7723,
    "error": null,
    "final_response_text": "Die Absatzm\u00e4rkte mit dem h\u00f6chsten Nettoerl\u00f6s nach Preisnachl\u00e4ssen sind:\n\n1. USA: CHF 245'584.61\n2. Deutschland: CHF 230'284.63\n3. \u00d6sterreich: CHF 128'003.84\n4. Brasilien: CHF 106'925.78\n5. Frankreich: CHF 81'358.32\n\nDiese Werte zeigen, welche L\u00e4nder den gr\u00f6\u00dften Beitrag zum Nettoerl\u00f6s leisten, nachdem Preisnachl\u00e4sse ber\u00fccksichtigt wurden.",
    "sql_query": "SELECT c.country, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS net_revenue\nFROM public.order_details od\nJOIN public.orders o ON od.order_id = o.order_id\nJOIN public.customers c ON o.customer_id = c.customer_id\nGROUP BY c.country\nORDER BY net_revenue DESC\nLIMIT 5;",
