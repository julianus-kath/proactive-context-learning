    "latency_ms_total": 5890,
    "error": null,
    "final_response_text": "Die L\u00e4nder mit dem gr\u00f6\u00dften rabattbereinigten Umsatz sind:\n\n1. USA: CHF 245'584.61\n2. Deutschland: CHF 230'284.63\n3. \u00d6sterreich: CHF 128'003.84\n4. Brasilien: CHF 106'925.78\n5. Frankreich: CHF 81'358.32",
    "sql_query": "SELECT c.country, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS rabattbereinigter_umsatz\nFROM public.order_details od\nJOIN public.orders o ON od.order_id = o.order_id\nJOIN public.customers c ON o.customer_id = c.customer_id\nGROUP BY c.country\nORDER BY rabattbereinigter_umsatz DESC\nLIMIT 5;",
