  "OE1": {
    "query_id": "OE1",
    "question": "Welche Kundenl\u00e4nder bringen den gr\u00f6\u00dften Gesamtumsatz nach Abz\u00fcgen?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 14919,
    "error": null,
    "final_response_text": "Die f\u00fcnf Kundenl\u00e4nder mit dem gr\u00f6\u00dften Gesamtumsatz nach Abz\u00fcgen sind:\n\n1. **USA**: CHF 245'585\n2. **Deutschland**: CHF 230'285\n3. **\u00d6sterreich**: CHF 128'004\n4. **Brasilien**: CHF 106'926\n5. **Frankreich**: CHF 81'358\n\nDiese Werte ber\u00fccksichtigen die Rabatte, die auf die Bestellungen angewendet wurden.",
    "sql_query": "SELECT o.ship_country AS Kundenland, \n       SUM(od.unit_price * od.quantity * (1 - od.discount)) AS Gesamtumsatz_nach_Abz\u00fcgen\nFROM public.orders o\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY o.ship_country\nORDER BY Gesamtumsatz_nach_Abz\u00fcgen DESC\nLIMIT 5;",
