  "LT1_CL2": {
    "query_id": "LT1_CL2",
    "question": "Zeige den gesamten Umsatz nach Rabatt pro Kundenland, absteigend nach Umsatz.",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 5304,
    "error": null,
    "final_response_text": "Hier ist der Gesamtumsatz nach Rabatt pro Kundenland, absteigend sortiert:\n\n1. USA: CHF 245'584.61\n2. Deutschland: CHF 230'284.63\n3. \u00d6sterreich: CHF 128'003.84\n4. Brasilien: CHF 106'925.78\n5. Frankreich: CHF 81'358.32\n\nWeitere L\u00e4nder folgen in der Liste. Wenn du mehr Details ben\u00f6tigst, lass es mich wissen!",
    "sql_query": "SELECT o.ship_country AS Kundenland, \n       SUM(od.unit_price * od.quantity * (1 - od.discount)) AS Gesamtumsatz\nFROM public.orders o\nJOIN public.order_details od ON o.order_id = od.order_id\nGROUP BY o.ship_country\nORDER BY Gesamtumsatz DESC;",
