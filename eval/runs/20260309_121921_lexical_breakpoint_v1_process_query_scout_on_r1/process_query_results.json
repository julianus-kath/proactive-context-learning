  "LB_CL6_LX1": {
    "query_id": "LB_CL6_LX1",
    "question": "Zeige pro Monat die Anzahl Auftr\u00e4ge und versp\u00e4teten Auslieferungen.",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 12379,
    "error": null,
    "final_response_text": "Hier sind die monatlichen Daten zu den Auftr\u00e4gen und versp\u00e4teten Auslieferungen:\n\n- **Juli 1996**: 22 Auftr\u00e4ge, 1 versp\u00e4tete Auslieferung\n- **August 1996**: 25 Auftr\u00e4ge, 2 versp\u00e4tete Auslieferungen\n- **September 1996**: 23 Auftr\u00e4ge, 2 versp\u00e4tete Auslieferungen\n- **Oktober 1996**: 26 Auftr\u00e4ge, 1 versp\u00e4tete Auslieferung\n- **November 1996**: 25 Auftr\u00e4ge, 0 versp\u00e4tete Auslieferungen\n\nDiese Muster setzen sich in den folgenden Monaten fort. Wenn du detailliertere Informationen f\u00fcr einen bestimmten Zeitraum ben\u00f6tigst, lass es mich wissen!",
    "sql_query": "SELECT \n    DATE_TRUNC('month', order_date) AS month, \n    COUNT(order_id) AS total_orders,\n    SUM(CASE WHEN shipped_date > required_date THEN 1 ELSE 0 END) AS late_shipments\nFROM \n    public.orders\nGROUP BY \n    DATE_TRUNC('month', order_date)\nORDER BY \n    month;",
