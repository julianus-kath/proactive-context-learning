  "LB_CL2_LX2": {
    "query_id": "LB_CL2_LX2",
    "question": "Welche Absatzl\u00e4nder liefern den gr\u00f6\u00dften Nettoerl\u00f6s nach Preisnachl\u00e4ssen?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 8365,
    "error": null,
    "final_response_text": "Die f\u00fcnf Absatzl\u00e4nder mit dem gr\u00f6\u00dften Nettoerl\u00f6s nach Preisnachl\u00e4ssen sind:\n\n1. USA mit einem Nettoerl\u00f6s von 245'584.61\n2. Deutschland mit einem Nettoerl\u00f6s von 230'284.63\n3. \u00d6sterreich mit einem Nettoerl\u00f6s von 128'003.84\n4. Brasilien mit einem Nettoerl\u00f6s von 106'925.78\n5. Frankreich mit einem Nettoerl\u00f6s von 81'358.32",
    "sql_query": "SELECT c.country, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS net_revenue\nFROM public.orders o\nJOIN public.order_details od ON o.order_id = od.order_id\nJOIN public.customers c ON o.customer_id = c.customer_id\nGROUP BY c.country\nORDER BY net_revenue DESC\nLIMIT 5;",
