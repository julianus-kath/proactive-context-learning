  "US_CL2_U3": {
    "query_id": "US_CL2_U3",
    "question": "Wo verdienen wir nach Rabatten am meisten Geld?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 9018,
    "error": null,
    "final_response_text": "Die Produkte, bei denen wir nach Rabatten am meisten verdienen, sind:\n\n1. **C\u00f4te de Blaye** mit einem Nettoumsatz von etwa CHF 141'397\n2. **Th\u00fcringer Rostbratwurst** mit einem Nettoumsatz von etwa CHF 80'369\n3. **Raclette Courdavault** mit einem Nettoumsatz von etwa CHF 71'156\n4. **Tarte au sucre** mit einem Nettoumsatz von etwa CHF 47'235\n5. **Camembert Pierrot** mit einem Nettoumsatz von etwa CHF 46'825\n\nDiese Produkte generieren den h\u00f6chsten Umsatz nach Abzug der Rabatte.",
    "sql_query": "SELECT p.product_name, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS net_revenue\nFROM public.order_details od\nJOIN public.products p ON od.product_id = p.product_id\nGROUP BY p.product_name\nORDER BY net_revenue DESC\nLIMIT 5;",
