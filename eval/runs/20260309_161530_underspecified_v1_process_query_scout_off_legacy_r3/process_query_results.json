  "US_CL2_U3": {
    "query_id": "US_CL2_U3",
    "question": "Wo verdienen wir nach Rabatten am meisten Geld?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 8307,
    "error": null,
    "final_response_text": "Die f\u00fcnf Produkte, bei denen wir nach Abzug der Rabatte am meisten verdienen, sind:\n\n1. **C\u00f4te de Blaye** mit einem Umsatz von CHF 141'397\n2. **Th\u00fcringer Rostbratwurst** mit einem Umsatz von CHF 80'369\n3. **Raclette Courdavault** mit einem Umsatz von CHF 71'156\n4. **Tarte au sucre** mit einem Umsatz von CHF 47'235\n5. **Camembert Pierrot** mit einem Umsatz von CHF 46'825\n\nDiese Ums\u00e4tze sind nach Abzug der gew\u00e4hrten Rabatte berechnet.",
    "sql_query": "SELECT p.product_name, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS revenue_after_discount\nFROM public.order_details od\nJOIN public.products p ON od.product_id = p.product_id\nGROUP BY p.product_name\nORDER BY revenue_after_discount DESC\nLIMIT 5;",
