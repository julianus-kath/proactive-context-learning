  "US_CL10_U1": {
    "query_id": "US_CL10_U1",
    "question": "Welche Kundengruppen bringen den meisten Nettoerl\u00f6s?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 17183,
    "error": null,
    "final_response_text": "Es scheint, dass es keine Daten gibt, die den Nettoerl\u00f6s nach Kundengruppen aufschl\u00fcsseln. M\u00f6glicherweise sind die Kundengruppen nicht korrekt zugeordnet oder es fehlen entsprechende Bestellungen in der Datenbank. Wenn du weitere Informationen ben\u00f6tigst oder eine andere Analyse w\u00fcnschst, lass es mich wissen!",
    "sql_query": "SELECT cd.customer_desc AS Kundengruppe, SUM(od.unit_price * od.quantity * (1 - od.discount)) AS Nettoerl\u00f6s\nFROM public.orders o\nJOIN public.order_details od ON o.order_id = od.order_id\nJOIN public.customers c ON o.customer_id = c.customer_id\nJOIN public.customer_customer_demo ccd ON c.customer_id = ccd.customer_id\nJOIN public.customer_demographics cd ON ccd.customer_type_id = cd.customer_type_id\nGROUP BY cd.customer_desc\nORDER BY Nettoerl\u00f6s DESC\nLIMIT 5;",
