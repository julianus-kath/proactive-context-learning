  "US_CL2_U1": {
    "query_id": "US_CL2_U1",
    "question": "Woher kommt unser Nettoumsatz?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 8305,
    "error": null,
    "final_response_text": "Der Nettoumsatz betr\u00e4gt insgesamt etwa 1.265.793,04. Dieser Wert wurde durch die Berechnung des Umsatzes aus den Bestellpositionen unter Ber\u00fccksichtigung von Preis, Menge und Rabatt ermittelt.",
    "sql_query": "SELECT SUM(od.unit_price * od.quantity * (1 - od.discount)) AS Nettoumsatz\nFROM public.order_details od\nJOIN public.orders o ON od.order_id = o.order_id",
