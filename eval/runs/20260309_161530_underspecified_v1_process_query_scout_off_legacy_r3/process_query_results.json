  "US_CL3_U2": {
    "query_id": "US_CL3_U2",
    "question": "\u00dcber wen kommt es am h\u00e4ufigsten zu Verz\u00f6gerungen?",
    "status": "success",
    "http_status": 200,
    "latency_ms_total": 8823,
    "error": null,
    "final_response_text": "Die Kunden, bei denen es am h\u00e4ufigsten zu Verz\u00f6gerungen kommt, sind:\n\n1. **Hungry Owl All-Night Grocers** mit 3 Verz\u00f6gerungen\n2. **Gourmet Lanchonetes** ebenfalls mit 3 Verz\u00f6gerungen\n3. **Bon app'** mit 2 Verz\u00f6gerungen\n4. **HILARION-Abastos** mit 2 Verz\u00f6gerungen\n5. **Berglunds snabbk\u00f6p** mit 2 Verz\u00f6gerungen\n\nDiese Kunden haben die meisten Bestellungen, bei denen das tats\u00e4chliche Lieferdatum nach dem geplanten Lieferdatum lag.",
    "sql_query": "SELECT c.company_name, COUNT(o.order_id) AS delay_count\nFROM public.orders o\nJOIN public.customers c ON o.customer_id = c.customer_id\nWHERE o.shipped_date > o.required_date\nGROUP BY c.company_name\nORDER BY delay_count DESC\nLIMIT 5;",
