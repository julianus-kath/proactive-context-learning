{"query_id": "NL_DE_05", "reference_sql": "WITH order_totals AS (\n    SELECT o.order_id, c.country,\n           SUM(od.unit_price * od.quantity * (1 - od.discount)) AS order_total\n    FROM public.orders o\n    JOIN public.customers c ON c.customer_id = o.customer_id\n    JOIN public.order_details od ON od.order_id = o.order_id\n    GROUP BY o.order_id, c.country\n)\nSELECT country, AVG(order_total) AS avg_order_value\nFROM order_totals\nGROUP BY country\nORDER BY avg_order_value DESC, country", "reference_columns": ["country", "avg_order_value"], "reference_rowset": [["Austria", 3200.095954], ["Ireland", 2630.52132], ["USA", 2012.988609], ["Germany", 1887.578961], ["Denmark", 1814.50125], ["Belgium", 1780.255541], ["Switzerland", 1760.703276], ["Canada", 1673.20967], ["Sweden", 1472.841619], ["Brazil", 1288.262366], ["Venezuela", 1235.013669], ["France", 1056.601591], ["UK", 1053.059106], ["Norway", 955.858336], ["Portugal", 882.489424], ["Finland", 855.002389], ["Mexico", 842.217053], ["Spain", 781.87826], ["Italy", 563.219818], ["Argentina", 507.443749], ["Poland", 504.564285]], "reference_rowcount": 21, "reference_has_order_by": false, "elapsed_ms": 3.4}
