{"query_id": "NL_DE_03", "reference_sql": "SELECT s.shipper_id, s.company_name,\n       COUNT(*) FILTER (WHERE o.shipped_date > o.required_date) AS late_shipments,\n       COUNT(*) AS total_shipments\nFROM public.shippers s\nJOIN public.orders o ON o.ship_via = s.shipper_id\nGROUP BY s.shipper_id, s.company_name\nORDER BY late_shipments DESC, s.shipper_id", "reference_columns": ["shipper_id", "company_name", "late_shipments", "total_shipments"], "reference_rowset": [[2.0, "United Package", 16.0, 326.0], [1.0, "Speedy Express", 12.0, 249.0], [3.0, "Federal Shipping", 9.0, 255.0]], "reference_rowcount": 3, "reference_has_order_by": false, "elapsed_ms": 1.9}
