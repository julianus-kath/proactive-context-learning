{"query_id": "NL_DE_07", "reference_sql": "SELECT s.supplier_id, s.company_name,\n       SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_revenue\nFROM public.suppliers s\nJOIN public.products p ON p.supplier_id = s.supplier_id\nJOIN public.order_details od ON od.product_id = p.product_id\nGROUP BY s.supplier_id, s.company_name\nORDER BY total_revenue DESC, s.supplier_id", "reference_columns": ["supplier_id", "company_name", "total_revenue"], "reference_rowset": [[18.0, "Aux joyeux eccl\u00e9siastiques", 153691.275503], [12.0, "Plutzer Lebensmittelgro\u00dfm\u00e4rkte AG", 145372.399669], [28.0, "Gai p\u00e2turage", 117981.180205], [7.0, "Pavlova, Ltd.", 106459.776078], [24.0, "G'day, Mate", 65626.770168], [29.0, "For\u00eats d'\u00e9rables", 61587.569853], [8.0, "Specialty Biscuits, Ltd.", 59032.080163], [26.0, "Pasta Buttini s.r.l.", 50254.609884], [14.0, "Formaggi Fortini s.r.l.", 48225.164374], [15.0, "Norske Meierier", 43141.510129], [20.0, "Leka Trading", 42017.645021], [3.0, "Grandma Kelly's Homestead", 41953.299976], [11.0, "Heli S\u00fc\u00dfwaren GmbH & Co. KG", 38653.419429], [2.0, "New Orleans Cajun Delights", 31167.989587], [4.0, "Tokyo Traders", 30526.339829], [23.0, "Karkki Oy", 28442.727385], [19.0, "New England Seafood Cannery", 26590.974317], [5.0, "Cooperativa de Quesos 'Las Cabras'", 25159.429822], [16.0, "Bigfoot Breweries", 22391.19981], [25.0, "Ma Maison", 22154.637721], [17.0, "Svensk Sj\u00f6f\u00f6da AB", 20144.059916], [1.0, "Exotic Liquids", 19399.959905], [6.0, "Mayumi's", 14736.75505], [13.0, "Nord-Ost-Fisch Handelsgesellschaft mbH", 13424.197396], [9.0, "PB Kn\u00e4ckebr\u00f6d AB", 11724.059941], [21.0, "Lyngbysild", 10221.175046], [27.0, "Escargots Nouveaux", 5881.675039], [22.0, "Zaanse Snoepfabriek", 5326.792467], [10.0, "Refrescos Americanas LTDA", 4504.364968]], "reference_rowcount": 29, "reference_has_order_by": false, "elapsed_ms": 1.6}
{"query_id": "NL_DE_08", "reference_sql": "SELECT s.shipper_id, s.company_name,\n       AVG(CASE WHEN o.shipped_date > o.required_date THEN (o.shipped_date - o.required_date)::numeric END) AS avg_late_days,\n       COUNT(*) FILTER (WHERE o.shipped_date > o.required_date) AS late_shipments,\n       COUNT(*) FILTER (WHERE o.shipped_date IS NOT NULL AND o.required_date IS NOT NULL) AS shipped_orders\nFROM public.shippers s\nJOIN public.orders o ON o.ship_via = s.shipper_id\nGROUP BY s.shipper_id, s.company_name\nORDER BY avg_late_days DESC NULLS LAST, s.shipper_id", "reference_columns": ["shipper_id", "company_name", "avg_late_days", "late_shipments", "shipped_orders"], "reference_rowset": [[1.0, "Speedy Express", 8.083333, 12.0, 245.0], [2.0, "United Package", 5.5625, 16.0, 315.0], [3.0, "Federal Shipping", 5.555556, 9.0, 249.0]], "reference_rowcount": 3, "reference_has_order_by": false, "elapsed_ms": 1.7}
{"query_id": "NL_DE_09", "reference_sql": "SELECT e.employee_id, e.first_name, e.last_name,\n       COUNT(DISTINCT o.customer_id) AS customer_count\nFROM public.employees e\nLEFT JOIN public.orders o ON o.employee_id = e.employee_id\nGROUP BY e.employee_id, e.first_name, e.last_name\nORDER BY customer_count DESC, e.employee_id", "reference_columns": ["employee_id", "first_name", "last_name", "customer_count"], "reference_rowset": [[4.0, "Margaret", "Peacock", 75.0], [1.0, "Nancy", "Davolio", 65.0], [3.0, "Janet", "Leverling", 63.0], [2.0, "Andrew", "Fuller", 59.0], [8.0, "Laura", "Callahan", 56.0], [7.0, "Robert", "King", 45.0], [6.0, "Michael", "Suyama", 43.0], [5.0, "Steven", "Buchanan", 29.0], [9.0, "Anne", "Dodsworth", 29.0]], "reference_rowcount": 9, "reference_has_order_by": false, "elapsed_ms": 2.7}
{"query_id": "NL_DE_10", "reference_sql": "SELECT c.customer_id, c.company_name\nFROM public.customers c\nLEFT JOIN public.orders o ON o.customer_id = c.customer_id\nWHERE o.order_id IS NULL\nORDER BY c.customer_id", "reference_columns": ["customer_id", "company_name"], "reference_rowset": [["FISSA", "FISSA Fabrica Inter. Salchichas S.A."], ["PARIS", "Paris sp\u00e9cialit\u00e9s"]], "reference_rowcount": 2, "reference_has_order_by": false, "elapsed_ms": 1.7}
{"query_id": "NW_DE_01", "reference_sql": "SELECT product_id, product_name, units_in_stock, reorder_level\nFROM public.products\nWHERE units_in_stock < reorder_level\nORDER BY (reorder_level - units_in_stock) DESC, product_id\nLIMIT 5", "reference_columns": ["product_id", "product_name", "units_in_stock", "reorder_level"], "reference_rowset": [[31.0, "Gorgonzola Telino", 0.0, 20.0], [32.0, "Mascarpone Fabioli", 9.0, 25.0], [66.0, "Louisiana Hot Spiced Okra", 4.0, 20.0], [70.0, "Outback Lager", 15.0, 30.0], [37.0, "Gravad lax", 11.0, 25.0]], "reference_rowcount": 5, "reference_has_order_by": false, "elapsed_ms": 5.9}
{"query_id": "NW_DE_02", "reference_sql": "SELECT c.category_name,\n       SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_revenue\nFROM public.categories c\nJOIN public.products p ON p.category_id = c.category_id\nJOIN public.order_details od ON od.product_id = p.product_id\nGROUP BY c.category_name\nORDER BY total_revenue DESC", "reference_columns": ["category_name", "total_revenue"], "reference_rowset": [["Beverages", 267868.179786], ["Dairy Products", 234507.284531], ["Confections", 167357.225473], ["Meat/Poultry", 163022.360269], ["Seafood", 131261.736556], ["Condiments", 106047.08461], ["Produce", 99984.580074], ["Grains/Cereals", 95744.587355]], "reference_rowcount": 8, "reference_has_order_by": false, "elapsed_ms": 2.0}
{"query_id": "NW_DE_03", "reference_sql": "SELECT c.customer_id, c.company_name,\n       COUNT(DISTINCT o.order_id) AS order_count,\n       SUM(od.unit_price * od.quantity) AS total_order_value\nFROM public.customers c\nJOIN public.orders o ON o.customer_id = c.customer_id\nJOIN public.order_details od ON od.order_id = o.order_id\nGROUP BY c.customer_id, c.company_name\nHAVING COUNT(DISTINCT o.order_id) > 10\nORDER BY total_order_value DESC, c.customer_id", "reference_columns": ["customer_id", "company_name", "order_count", "total_order_value"], "reference_rowset": [["QUICK", "QUICK-Stop", 28.0, 117483.390148], ["SAVEA", "Save-a-lot Markets", 31.0, 115673.389643], ["ERNSH", "Ernst Handel", 30.0, 113236.679782], ["HUNGO", "Hungry Owl All-Night Grocers", 19.0, 57317.390162], ["RATTC", "Rattlesnake Canyon Grocery", 18.0, 52245.900347], ["HANAR", "Hanari Carnes", 14.0, 34101.149974], ["FOLKO", "Folk och f\u00e4 HB", 19.0, 32555.550019], ["MEREP", "M\u00e8re Paillarde", 13.0, 32203.900234], ["KOENE", "K\u00f6niglich Essen", 14.0, 31745.749893], ["QUEEN", "Queen Cozinha", 13.0, 30226.10018], ["WHITC", "White Clover Markets", 14.0, 29073.449927], ["FRANK", "Frankenversand", 15.0, 28722.709939], ["BERGS", "Berglunds snabbk\u00f6p", 18.0, 26968.14993], ["SUPRD", "Supr\u00eames d\u00e9lices", 12.0, 24704.400304], ["BONAP", "Bon app'", 17.0, 23850.949986], ["HILAA", "HILARION-Abastos", 18.0, 23611.579945], ["BOTTM", "Bottom-Dollar Markets", 14.0, 22607.699961], ["LEHMS", "Lehmanns Marktstand", 15.0, 21282.019977], ["GREAL", "Great Lakes Food Market", 11.0, 19711.129995], ["BLONP", "Blondesddsl p\u00e8re et fils", 11.0, 19088.000093], ["LINOD", "LINO-Delicateses", 12.0, 17889.549932], ["LILAS", "LILA-Supermercado", 14.0, 17825.059958], ["VAFFE", "Vaffeljernet", 11.0, 16643.799894], ["WARTH", "Wartian Herkku", 15.0, 16617.10012], ["AROUT", "Around the Horn", 13.0, 13806.499981], ["RICAR", "Ricardo Adocicados", 11.0, 12924.400025], ["LAMAI", "La maison d'Asie", 14.0, 10272.350024], ["REGGC", "Reggiani Caseifici", 12.0, 7555.599969]], "reference_rowcount": 28, "reference_has_order_by": false, "elapsed_ms": 3.4}
{"query_id": "NW_DE_04", "reference_sql": "SELECT s.shipper_id, s.company_name,\n       COUNT(*) FILTER (WHERE o.shipped_date > o.required_date) AS late_shipments,\n       COUNT(*) AS total_shipments\nFROM public.shippers s\nJOIN public.orders o ON o.ship_via = s.shipper_id\nGROUP BY s.shipper_id, s.company_name\nORDER BY s.shipper_id", "reference_columns": ["shipper_id", "company_name", "late_shipments", "total_shipments"], "reference_rowset": [[1.0, "Speedy Express", 12.0, 249.0], [2.0, "United Package", 16.0, 326.0], [3.0, "Federal Shipping", 9.0, 255.0]], "reference_rowcount": 3, "reference_has_order_by": false, "elapsed_ms": 0.9}
{"query_id": "NW_DE_05", "reference_sql": "SELECT e.employee_id, e.first_name, e.last_name,\n       SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_revenue\nFROM public.employees e\nJOIN public.orders o ON o.employee_id = e.employee_id\nJOIN public.order_details od ON od.order_id = o.order_id\nGROUP BY e.employee_id, e.first_name, e.last_name\nORDER BY total_revenue DESC", "reference_columns": ["employee_id", "first_name", "last_name", "total_revenue"], "reference_rowset": [[4.0, "Margaret", "Peacock", 232890.845982], [3.0, "Janet", "Leverling", 202812.842388], [1.0, "Nancy", "Davolio", 192107.604657], [2.0, "Andrew", "Fuller", 166537.755287], [8.0, "Laura", "Callahan", 126862.277478], [7.0, "Robert", "King", 124568.234851], [9.0, "Anne", "Dodsworth", 77308.066238], [6.0, "Michael", "Suyama", 73913.129378], [5.0, "Steven", "Buchanan", 68792.282394]], "reference_rowcount": 9, "reference_has_order_by": false, "elapsed_ms": 2.8}
{"query_id": "NW_DE_06", "reference_sql": "SELECT p.product_id, p.product_name,\n       SUM(od.quantity) AS quantity_sold\nFROM public.products p\nJOIN public.order_details od ON od.product_id = p.product_id\nGROUP BY p.product_id, p.product_name\nORDER BY quantity_sold DESC, p.product_id\nLIMIT 5", "reference_columns": ["product_id", "product_name", "quantity_sold"], "reference_rowset": [[60.0, "Camembert Pierrot", 1577.0], [59.0, "Raclette Courdavault", 1496.0], [31.0, "Gorgonzola Telino", 1397.0], [56.0, "Gnocchi di nonna Alice", 1263.0], [16.0, "Pavlova", 1158.0]], "reference_rowcount": 5, "reference_has_order_by": false, "elapsed_ms": 3.0}
{"query_id": "NW_DE_07", "reference_sql": "SELECT s1.company_name AS supplier_1, s2.company_name AS supplier_2,\n       COUNT(DISTINCT od1.order_id) AS co_order_count\nFROM public.order_details od1\nJOIN public.order_details od2 ON od1.order_id = od2.order_id AND od1.product_id <> od2.product_id\nJOIN public.products p1 ON p1.product_id = od1.product_id\nJOIN public.products p2 ON p2.product_id = od2.product_id\nJOIN public.suppliers s1 ON s1.supplier_id = p1.supplier_id\nJOIN public.suppliers s2 ON s2.supplier_id = p2.supplier_id\nWHERE s1.supplier_id < s2.supplier_id\nGROUP BY s1.company_name, s2.company_name\nORDER BY co_order_count DESC, s1.company_name, s2.company_name\nLIMIT 10", "reference_columns": ["supplier_1", "supplier_2", "co_order_count"], "reference_rowset": [["Specialty Biscuits, Ltd.", "Plutzer Lebensmittelgro\u00dfm\u00e4rkte AG", 25.0], ["Pavlova, Ltd.", "Formaggi Fortini s.r.l.", 22.0], ["Pavlova, Ltd.", "Plutzer Lebensmittelgro\u00dfm\u00e4rkte AG", 21.0], ["Pavlova, Ltd.", "Gai p\u00e2turage", 20.0], ["Specialty Biscuits, Ltd.", "Gai p\u00e2turage", 19.0], ["Specialty Biscuits, Ltd.", "Norske Meierier", 19.0], ["Pavlova, Ltd.", "Norske Meierier", 18.0], ["Pavlova, Ltd.", "Specialty Biscuits, Ltd.", 18.0], ["Specialty Biscuits, Ltd.", "G'day, Mate", 18.0], ["Pavlova, Ltd.", "For\u00eats d'\u00e9rables", 17.0]], "reference_rowcount": 10, "reference_has_order_by": false, "elapsed_ms": 9.9}
{"query_id": "NW_DE_08", "reference_sql": "WITH order_totals AS (\n    SELECT o.order_id, c.country,\n           SUM(od.unit_price * od.quantity * (1 - od.discount)) AS order_total\n    FROM public.orders o\n    JOIN public.customers c ON c.customer_id = o.customer_id\n    JOIN public.order_details od ON od.order_id = o.order_id\n    GROUP BY o.order_id, c.country\n)\nSELECT country, AVG(order_total) AS avg_order_value\nFROM order_totals\nGROUP BY country\nORDER BY avg_order_value DESC, country", "reference_columns": ["country", "avg_order_value"], "reference_rowset": [["Austria", 3200.095954], ["Ireland", 2630.52132], ["USA", 2012.988609], ["Germany", 1887.578961], ["Denmark", 1814.50125], ["Belgium", 1780.255541], ["Switzerland", 1760.703276], ["Canada", 1673.20967], ["Sweden", 1472.841619], ["Brazil", 1288.262366], ["Venezuela", 1235.013669], ["France", 1056.601591], ["UK", 1053.059106], ["Norway", 955.858336], ["Portugal", 882.489424], ["Finland", 855.002389], ["Mexico", 842.217053], ["Spain", 781.87826], ["Italy", 563.219818], ["Argentina", 507.443749], ["Poland", 504.564285]], "reference_rowcount": 21, "reference_has_order_by": false, "elapsed_ms": 2.5}
{"query_id": "NW_DE_09", "reference_sql": "SELECT COUNT(DISTINCT o.order_id) AS pending_orders,\n       SUM(od.unit_price * od.quantity * (1 - od.discount)) AS total_value\nFROM public.orders o\nJOIN public.order_details od ON od.order_id = o.order_id\nWHERE o.shipped_date IS NULL", "reference_columns": ["pending_orders", "total_value"], "reference_rowset": [[21.0, 25937.430326]], "reference_rowcount": 1, "reference_has_order_by": false, "elapsed_ms": 1.4}
{"query_id": "NW_DE_10", "reference_sql": "SELECT DATE_TRUNC('month', o.order_date)::date AS month,\n       SUM(od.unit_price * od.quantity * (1 - od.discount)) AS revenue\nFROM public.orders o\nJOIN public.order_details od ON od.order_id = o.order_id\nGROUP BY DATE_TRUNC('month', o.order_date)::date\nORDER BY month", "reference_columns": ["month", "revenue"], "reference_rowset": [["1996-07-01", 27861.89513], ["1996-08-01", 25485.275071], ["1996-09-01", 26381.400133], ["1996-10-01", 37515.724945], ["1996-11-01", 45600.045211], ["1996-12-01", 45239.630493], ["1997-01-01", 61258.070168], ["1997-02-01", 38483.63495], ["1997-03-01", 38547.22011], ["1997-04-01", 53032.952389], ["1997-05-01", 53781.289825], ["1997-06-01", 36362.802335], ["1997-07-01", 51020.857519], ["1997-08-01", 47287.669688], ["1997-09-01", 55629.242402], ["1997-10-01", 66749.225776], ["1997-11-01", 43533.808768], ["1997-12-01", 71398.428464], ["1998-01-01", 94222.110207], ["1998-02-01", 99415.287383], ["1998-03-01", 104854.155], ["1998-04-01", 123798.682256], ["1998-05-01", 18333.630432]], "reference_rowcount": 23, "reference_has_order_by": false, "elapsed_ms": 3.9}
