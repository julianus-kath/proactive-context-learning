# ============================================
# MCP Server Configuration - Phase 1
# ============================================

# Database Dialect Selection
# Options: postgres (dev) | mssql (production)
DB_DIALECT=postgres

# ============================================
# PostgreSQL Configuration (Dev Mode)
# ============================================
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DATABASE=synthetic_erp_data
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# ============================================
# SQL Server Configuration (Production Mode)
# ============================================
MSSQL_SERVER=your-server.database.windows.net
MSSQL_DATABASE=your_database
MSSQL_USER=your_user
MSSQL_PASSWORD=your_password
MSSQL_DRIVER=ODBC Driver 17 for SQL Server

# ============================================
# Legacy Configuration (Backward Compatibility)
# ============================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=synthetic_erp_data
DB_USER=postgres
DB_PASSWORD=postgres

# ============================================
# Query Safety & Performance
# ============================================
MAX_QUERY_RESULTS=1000
QUERY_TIMEOUT=30
MIN_POOL_SIZE=1
MAX_POOL_SIZE=10