# MongoDB Document Store Configuration

# MongoDB Connection
MONGODB_URL=mongodb://localhost:27017
MONGODB_DATABASE=erp_document_store

# Optional: MongoDB Authentication (if using authentication)
# MONGODB_USERNAME=your_username
# MONGODB_PASSWORD=your_password

# Optional: MongoDB Atlas connection (cloud)
# MONGODB_URL=mongodb+srv://username:password@cluster.mongodb.net/

# Data Generation Settings
DEFAULT_SEED=42

# Optional: OpenAI API Key for enhanced text generation
# OPENAI_API_KEY=your_openai_api_key_here

# Logging Level
LOG_LEVEL=INFO